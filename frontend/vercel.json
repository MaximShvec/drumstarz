  "rewrites": [
    {
      "source": "/((?!robots\\.txt|sitemap\\.xml|og\\.jpg|humans\\.txt|llms\\.txt|site\\.webmanifest|\\.well-known/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
